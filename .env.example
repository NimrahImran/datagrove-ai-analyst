# Copy to .env for local development. In production, set these in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash, falls back automatically)
GEMINI_MODEL=
# Contact form: Gmail with an App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where contact messages are delivered (optional; defaults to GMAIL_USER)
CONTACT_TO=
# Contact form backup: free access key from web3forms.com (sent from the browser if Gmail fails)
WEB3FORMS_ACCESS_KEY=
