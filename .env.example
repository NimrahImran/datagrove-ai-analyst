# Copy to .env for local development. In production, set these in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash, falls back automatically)
GEMINI_MODEL=
# Contact form, option A (recommended on Vercel): Resend API key from resend.com
RESEND_API_KEY=
# Contact form, option B: Gmail SMTP with an App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where contact messages are delivered (required with Resend; defaults to GMAIL_USER)
CONTACT_TO=
