# Copy to .env for local development. In production, set these in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash, falls back automatically)
GEMINI_MODEL=
# Contact form (Gmail App Password, not your normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: where contact messages are delivered (defaults to GMAIL_USER)
CONTACT_TO=
